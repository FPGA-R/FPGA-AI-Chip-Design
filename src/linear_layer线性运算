`timescale 1ns / 1ps

module uart_linear_top #(
    parameter integer CLK_FREQ  = 100_000_000,
    parameter integer BAUD_RATE = 115200
)(
    input  wire clk_100m,
    input  wire rst_n,
    input  wire uart_rx,
    output wire uart_tx
);

    localparam integer CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;

    // =====================================================
    // 1. UART接收
    // =====================================================

    wire [7:0] rx_data;
    wire       rx_valid;

    uart_rx_module #(
        .CLKS_PER_BIT(CLKS_PER_BIT)
    ) u_uart_rx (
        .clk      (clk_100m),
        .rst_n    (rst_n),
        .uart_rx  (uart_rx),
        .rx_data  (rx_data),
        .rx_valid (rx_valid)
    );

    // =====================================================
    // 2. UART发送
    // =====================================================

    wire       tx_start;
    wire [7:0] tx_data;
    wire       tx_busy;

    uart_tx_module #(
        .CLKS_PER_BIT(CLKS_PER_BIT)
    ) u_uart_tx (
        .clk      (clk_100m),
        .rst_n    (rst_n),
        .tx_start (tx_start),
        .tx_data  (tx_data),
        .uart_tx  (uart_tx),
        .tx_busy  (tx_busy)
    );

    // =====================================================
    // 3. Linear输入数据寄存器
    // =====================================================

    reg signed [7:0] x0, x1, x2;
    reg signed [7:0] w0, w1, w2;
    reg signed [31:0] bias;

    reg linear_start;

    wire linear_done;
    wire signed [31:0] linear_y;

    linear_layer u_linear_layer (
        .clk   (clk_100m),
        .rst_n (rst_n),
        .start (linear_start),

        .x0 (x0),
        .x1 (x1),
        .x2 (x2),

        .w0 (w0),
        .w1 (w1),
        .w2 (w2),

        .bias (bias),

        .done (linear_done),
        .y    (linear_y)
    );

    // =====================================================
    // 4. 接收指令
    //
    // 请求格式：
    // A5 10 x0 x1 x2 w0 w1 w2 bias
    //
    // =====================================================

    localparam CMD_HEADER = 2'd0;
    localparam CMD_OPCODE = 2'd1;
    localparam CMD_DATA   = 2'd2;

    reg [1:0] cmd_state;
    reg [3:0] data_index;

    reg [7:0] opcode_reg;

    // =====================================================
    // 5. 发送响应状态机
    // =====================================================

    localparam RSP_IDLE      = 3'd0;
    localparam RSP_WAIT_CALC = 3'd1;
    localparam RSP_SEND      = 3'd2;
    localparam RSP_WAIT_BUSY = 3'd3;
    localparam RSP_WAIT_DONE = 3'd4;

    reg [2:0] rsp_state;
    reg [2:0] rsp_index;

    reg signed [31:0] result_reg;

    // =====================================================
    // 6. 选择当前需要发送的字节
    //
    // 响应格式：
    // 5A 10 y[31:24] y[23:16] y[15:8] y[7:0]
    // =====================================================

    reg [7:0] tx_data_select;

    always @(*) begin
        case (rsp_index)
            3'd0: tx_data_select = 8'h5A;
            3'd1: tx_data_select = 8'h10;
            3'd2: tx_data_select = result_reg[31:24];
            3'd3: tx_data_select = result_reg[23:16];
            3'd4: tx_data_select = result_reg[15:8];
            3'd5: tx_data_select = result_reg[7:0];
            default: tx_data_select = 8'h00;
        endcase
    end

    assign tx_data = tx_data_select;

    // 发送状态机处于SEND且UART发送模块空闲时，启动发送
    assign tx_start =
        (rsp_state == RSP_SEND) && (!tx_busy);

    // =====================================================
    // 7. 主控制逻辑
    // =====================================================

    always @(posedge clk_100m or negedge rst_n) begin

        if (!rst_n) begin

            cmd_state   <= CMD_HEADER;
            data_index  <= 0;
            opcode_reg  <= 0;

            x0   <= 0;
            x1   <= 0;
            x2   <= 0;

            w0   <= 0;
            w1   <= 0;
            w2   <= 0;

            bias <= 0;

            linear_start <= 0;

            result_reg <= 0;

            rsp_state <= RSP_IDLE;
            rsp_index <= 0;

        end
        else begin

            // 默认不启动Linear
            linear_start <= 0;

            // ---------------------------------------------
            // A. 接收并解析串口指令
            // ---------------------------------------------

            if ((rsp_state == RSP_IDLE) && rx_valid) begin

                case (cmd_state)

                    // 等待帧头A5
                    CMD_HEADER: begin

                        if (rx_data == 8'hA5) begin
                            cmd_state <= CMD_OPCODE;
                        end

                    end

                    // 接收指令编号
                    CMD_OPCODE: begin

                        opcode_reg <= rx_data;

                        if (rx_data == 8'h10) begin
                            data_index <= 0;
                            cmd_state <= CMD_DATA;
                        end
                        else begin
                            cmd_state <= CMD_HEADER;
                        end

                    end

                    // 依次接收7个数据字节
                    CMD_DATA: begin

                        
case (data_index)

    4'd0: x0 <= rx_data;
    4'd1: x1 <= rx_data;
    4'd2: x2 <= rx_data;

    4'd3: w0 <= rx_data;
    4'd4: w1 <= rx_data;
    4'd5: w2 <= rx_data;

    // 最后一个字节：Bias
    4'd6: begin

        bias <= {{24{rx_data[7]}}, rx_data};

        // 启动Linear计算
        linear_start <= 1;

        // 接收完毕
        cmd_state <= CMD_HEADER;
        rsp_state <= RSP_WAIT_CALC;

    end

    default: begin
        cmd_state <= CMD_HEADER;
    end

endcase

if (data_index != 4'd6) begin
    data_index <= data_index + 1'b1;
end


                        if (data_index != 4'd6)
    data_index <= data_index + 1'b1;
                        end


                    default: begin
                        cmd_state <= CMD_HEADER;
                    end

                endcase

            end

            // ---------------------------------------------
            // B. 等待Linear计算完成
            // ---------------------------------------------

            case (rsp_state)

                RSP_IDLE: begin
                    // 等待电脑发送完整指令
                end

                RSP_WAIT_CALC: begin

                    if (linear_done) begin

                        // 保存计算结果
                        result_reg <= linear_y;

                        // 从响应第一个字节开始发送
                        rsp_index <= 0;
                        rsp_state <= RSP_SEND;

                    end

                end

                // -----------------------------------------
                // C. 逐字节发送计算结果
                // -----------------------------------------

                RSP_SEND: begin

                    if (!tx_busy) begin
                        rsp_state <= RSP_WAIT_BUSY;
                    end

                end

                RSP_WAIT_BUSY: begin

                    if (tx_busy) begin
                        rsp_state <= RSP_WAIT_DONE;
                    end

                end

                RSP_WAIT_DONE: begin

                    if (!tx_busy) begin

                        if (rsp_index == 3'd5) begin
                            // 6个字节全部发送完成
                            rsp_state <= RSP_IDLE;
                        end
                        else begin
                            rsp_index <= rsp_index + 1'b1;
                            rsp_state <= RSP_SEND;
                        end

                    end

                end

                default: begin
                    rsp_state <= RSP_IDLE;
                end

            endcase

        end

    end

endmodule


// =========================================================
// UART接收模块：115200 baud，8位数据，1位停止位
// =========================================================

module uart_rx_module #(
    parameter integer CLKS_PER_BIT = 868
)(
    input  wire clk,
    input  wire rst_n,
    input  wire uart_rx,

    output reg [7:0] rx_data,
    output reg       rx_valid
);

    localparam IDLE  = 2'd0;
    localparam START = 2'd1;
    localparam DATA  = 2'd2;
    localparam STOP  = 2'd3;

    reg [1:0] state;
    reg [15:0] clk_count;
    reg [2:0] bit_index;

    reg [7:0] rx_shift;

    reg rx_sync1;
    reg rx_sync2;

    // 两级同步器
    always @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin
            rx_sync1 <= 1'b1;
            rx_sync2 <= 1'b1;
        end
        else begin
            rx_sync1 <= uart_rx;
            rx_sync2 <= rx_sync1;
        end

    end

    always @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin

            state     <= IDLE;
            clk_count <= 0;
            bit_index <= 0;
            rx_shift  <= 0;
            rx_data   <= 0;
            rx_valid  <= 0;

        end
        else begin

            rx_valid <= 0;

            case (state)

                IDLE: begin

                    clk_count <= 0;
                    bit_index <= 0;

                    if (rx_sync2 == 0) begin
                        state <= START;
                    end

                end

                START: begin

                    if (clk_count == (CLKS_PER_BIT / 2 - 1)) begin

                        clk_count <= 0;

                        if (rx_sync2 == 0)
                            state <= DATA;
                        else
                            state <= IDLE;

                    end
                    else begin
                        clk_count <= clk_count + 1'b1;
                    end

                end

                DATA: begin

                    if (clk_count == CLKS_PER_BIT - 1) begin

                        clk_count <= 0;

                        // UART数据位低位先传输
                        rx_shift[bit_index] <= rx_sync2;

                        if (bit_index == 3'd7) begin
                            bit_index <= 0;
                            state <= STOP;
                        end
                        else begin
                            bit_index <= bit_index + 1'b1;
                        end

                    end
                    else begin
                        clk_count <= clk_count + 1'b1;
                    end

                end

                STOP: begin

                    if (clk_count == CLKS_PER_BIT - 1) begin

                        clk_count <= 0;
                        state <= IDLE;

                        if (rx_sync2 == 1'b1) begin
                            rx_data <= rx_shift;
                            rx_valid <= 1'b1;
                        end

                    end
                    else begin
                        clk_count <= clk_count + 1'b1;
                    end

                end

                default: begin
                    state <= IDLE;
                    clk_count <= 0;
                end

            endcase

        end

    end

endmodule


// =========================================================
// UART发送模块：115200 baud，8位数据，1位停止位
// =========================================================

module uart_tx_module #(
    parameter integer CLKS_PER_BIT = 868
)(
    input  wire clk,
    input  wire rst_n,

    input  wire       tx_start,
    input  wire [7:0] tx_data,

    output reg  uart_tx,
    output wire tx_busy
);

    localparam IDLE  = 2'd0;
    localparam START = 2'd1;
    localparam DATA  = 2'd2;
    localparam STOP  = 2'd3;

    reg [1:0] state;
    reg [15:0] clk_count;
    reg [2:0] bit_index;
    reg [7:0] tx_shift;

    assign tx_busy = (state != IDLE);

    always @(posedge clk or negedge rst_n) begin

        if (!rst_n) begin

            state     <= IDLE;
            clk_count <= 0;
            bit_index <= 0;
            tx_shift  <= 0;
            uart_tx   <= 1'b1;

        end
        else begin

            case (state)

                IDLE: begin

                    uart_tx   <= 1'b1;
                    clk_count <= 0;
                    bit_index <= 0;

                    if (tx_start) begin
                        tx_shift <= tx_data;
                        uart_tx  <= 1'b0;
                        state    <= START;
                    end

                end

                START: begin

                    if (clk_count == CLKS_PER_BIT - 1) begin

                        clk_count <= 0;
                        bit_index <= 0;

                        uart_tx <= tx_shift[0];
                        state <= DATA;

                    end
                    else begin
                        clk_count <= clk_count + 1'b1;
                    end

                end

                DATA: begin

                    if (clk_count == CLKS_PER_BIT - 1) begin

                        clk_count <= 0;

                        if (bit_index == 3'd7) begin
                            uart_tx <= 1'b1;
                            state <= STOP;
                        end
                        else begin
                            bit_index <= bit_index + 1'b1;
                            uart_tx <= tx_shift[bit_index + 1'b1];
                        end

                    end
                    else begin
                        clk_count <= clk_count + 1'b1;
                    end

                end

                STOP: begin

                    if (clk_count == CLKS_PER_BIT - 1) begin
                        clk_count <= 0;
                        state <= IDLE;
                    end
                    else begin
                        clk_count <= clk_count + 1'b1;
                    end

                end

                default: begin
                    state <= IDLE;
                    uart_tx <= 1'b1;
                    clk_count <= 0;
                end

            endcase

        end

    end

endmodule









linear_layer.v

`timescale 1ns / 1ps

module linear_layer (
    input wire clk,
    input wire rst_n,
    input wire start,

    input wire signed [7:0] x0,
    input wire signed [7:0] x1,
    input wire signed [7:0] x2,

    input wire signed [7:0] w0,
    input wire signed [7:0] w1,
    input wire signed [7:0] w2,

    input wire signed [31:0] bias,

    output reg done,
    output reg signed [31:0] y
);

    localparam IDLE  = 2'd0;
    localparam CALC0 = 2'd1;
    localparam CALC1 = 2'd2;
    localparam CALC2 = 2'd3;

    reg [1:0] state;

    reg signed [7:0] x0_reg, x1_reg, x2_reg;
    reg signed [7:0] w0_reg, w1_reg, w2_reg;

    reg signed [31:0] bias_reg;
    reg signed [31:0] accumulator;

    wire signed [15:0] product;

    reg signed [7:0] current_x;
    reg signed [7:0] current_w;

    assign product = current_x * current_w;

    always @(*) begin
        case (state)
            CALC0: begin
                current_x = x0_reg;
                current_w = w0_reg;
            end

            CALC1: begin
                current_x = x1_reg;
                current_w = w1_reg;
            end

            CALC2: begin
                current_x = x2_reg;
                current_w = w2_reg;
            end

            default: begin
                current_x = 8'sd0;
                current_w = 8'sd0;
            end
        endcase
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state <= IDLE;

            accumulator <= 32'sd0;
            bias_reg <= 32'sd0;
            y <= 32'sd0;
            done <= 1'b0;

            x0_reg <= 8'sd0;
            x1_reg <= 8'sd0;
            x2_reg <= 8'sd0;

            w0_reg <= 8'sd0;
            w1_reg <= 8'sd0;
            w2_reg <= 8'sd0;
        end
        else begin
            done <= 1'b0;

            case (state)

                IDLE: begin
                    if (start) begin
                        x0_reg <= x0;
                        x1_reg <= x1;
                        x2_reg <= x2;

                        w0_reg <= w0;
                        w1_reg <= w1;
                        w2_reg <= w2;

                        bias_reg <= bias;

                        accumulator <= 32'sd0;
                        state <= CALC0;
                    end
                end

                CALC0: begin
                    accumulator <= accumulator +
                                   {{16{product[15]}}, product};
                    state <= CALC1;
                end

                CALC1: begin
                    accumulator <= accumulator +
                                   {{16{product[15]}}, product};
                    state <= CALC2;
                end

                CALC2: begin
                    y <= accumulator +
                         {{16{product[15]}}, product} +
                         bias_reg;

                    done <= 1'b1;
                    state <= IDLE;
                end

                default: begin
                    state <= IDLE;
                end

            endcase
        end
    end

endmodule









tb_linear_layer.v

`timescale 1ns / 1ps

module tb_linear_layer;

    reg clk;
    reg rst_n;
    reg start;

    reg signed [7:0] x0, x1, x2;
    reg signed [7:0] w0, w1, w2;
    reg signed [31:0] bias;

    wire done;
    wire signed [31:0] y;

    integer pass_count;
    integer fail_count;

    linear_layer uut (
        .clk(clk),
        .rst_n(rst_n),
        .start(start),
        .x0(x0),
        .x1(x1),
        .x2(x2),
        .w0(w0),
        .w1(w1),
        .w2(w2),
        .bias(bias),
        .done(done),
        .y(y)
    );

    always #5 clk = ~clk;

    // 执行一次测试并检查结果
    task run_test;
        input [8*40-1:0] test_name;
        input signed [7:0] tx0, tx1, tx2;
        input signed [7:0] tw0, tw1, tw2;
        input signed [31:0] test_bias;
        input signed [31:0] expected;
        begin
            // 设置输入
            @(negedge clk);
            x0 = tx0;
            x1 = tx1;
            x2 = tx2;
            w0 = tw0;
            w1 = tw1;
            w2 = tw2;
            bias = test_bias;

            // 启动计算
            @(negedge clk);
            start = 1;

            @(negedge clk);
            start = 0;

            // 等待计算完成
            wait(done == 1);
            #1;

            // 检查结果
            if (y === expected) begin
                $display("[PASS] %0s: y = %0d",
                         test_name, y);
                pass_count = pass_count + 1;
            end
            else begin
                $display("[FAIL] %0s: expected %0d, got %0d",
                         test_name, expected, y);
                fail_count = fail_count + 1;
            end

            // 给下一次测试留出间隔
            @(negedge clk);
        end
    endtask

    initial begin
        clk = 0;
        rst_n = 0;
        start = 0;

        x0 = 0; x1 = 0; x2 = 0;
        w0 = 0; w1 = 0; w2 = 0;

        pass_count = 0;
        fail_count = 0;

        // 复位
        #20;
        rst_n = 1;

        // 测试1：基础正数
        run_test("Positive test",
         2, 3, 4,
         1, 2, 3,
         0,
         20);

        // 测试2：正负数混合
        run_test("Negative test",
                 -2, 4, 5,
                 3, -1, 2,
                 0,
                 0);

        // 测试3：INT8边界值
        run_test("INT8 boundary test",
                 -128, 127, 127,
                 127, -128, 127,
                 0,
                 -16383);

        // 测试4：全零输入
        run_test("Zero test",
                 0, 0, 0,
                 0, 0, 0,
                 0,
                 0);
                 
        run_test("Bias test",
         2, 3, 4,
         1, 2, 3,
         5,
         25);

        // 输出最终统计
        $display("--------------------------------");
        $display("TEST SUMMARY");
        $display("Total tests : %0d", pass_count + fail_count);
        $display("Passed      : %0d", pass_count);
        $display("Failed      : %0d", fail_count);
        $display("--------------------------------");

        if (fail_count == 0)
            $display("ALL TESTS PASSED!");
        else
            $display("SOME TESTS FAILED!");

        #20;
        $finish;
    end

endmodule










# 100MHz 时钟
create_clock -name clk_100m -period 10 [get_ports clk_100m]
set_property PACKAGE_PIN C8 [get_ports clk_100m]
set_property IOSTANDARD LVCMOS18 [get_ports clk_100m]

# 复位
set_property PACKAGE_PIN H13 [get_ports rst_n]
set_property IOSTANDARD LVCMOS18 [get_ports rst_n]

# FEP UART：默认 3.3V
# B22 UART_TXD -> AF15 -> FPGA uart_rx
# B23 UART_RXD -> AF14 -> FPGA uart_tx
set_property PACKAGE_PIN AF14 [get_ports uart_tx]
set_property PACKAGE_PIN AF15 [get_ports uart_rx]
set_property IOSTANDARD LVCMOS33 [get_ports {uart_tx uart_rx}]
