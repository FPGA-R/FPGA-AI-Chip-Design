module mac_int8 (
    input  wire               clk,
    input  wire               rst_n,

    input  wire               clear,
    input  wire               en,

    input  wire signed [7:0]  a,
    input  wire signed [7:0]  b,

    output reg  signed [31:0] acc,
    output reg                acc_valid
);

    // 8位有符号乘法，得到16位有符号结果
    wire signed [15:0] product;
    assign product = a * b;

    // 将16位乘积符号扩展到32位
    wire signed [31:0] product_ext;
    assign product_ext = {{16{product[15]}}, product};

    // 累加控制
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            acc       <= 32'sd0;
            acc_valid <= 1'b0;
        end
        else begin
            // 默认输出一个时钟周期的有效脉冲
            acc_valid <= 1'b0;

            if (clear) begin
                acc <= 32'sd0;
            end
            else if (en) begin
                acc       <= acc + product_ext;
                acc_valid <= 1'b1;
            end
        end
    end

endmodule











