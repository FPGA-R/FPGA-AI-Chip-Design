#mac_int8.v
module mac_int8 (
    input  wire               clk,
    input  wire               rst_n,

    input  wire               clear,
    input  wire               en,

    input  wire signed [7:0]  a,
    input  wire signed [7:0]  b,

    output reg  signed [31:0] acc,
    output reg                acc_valid
);

    // 8位有符号乘法，得到16位有符号结果
    wire signed [15:0] product;
    assign product = a * b;

    // 将16位乘积符号扩展到32位
    wire signed [31:0] product_ext;
    assign product_ext = {{16{product[15]}}, product};

    // 累加控制
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            acc       <= 32'sd0;
            acc_valid <= 1'b0;
        end
        else begin
            // 默认输出一个时钟周期的有效脉冲
            acc_valid <= 1'b0;

            if (clear) begin
                acc <= 32'sd0;
            end
            else if (en) begin
                acc       <= acc + product_ext;
                acc_valid <= 1'b1;
            end
        end
    end

endmodule


#tb_mac int8.v

`timescale 1ns / 1ps

module tb_mac_int8;

    reg clk;
    reg rst_n;
    reg clear;
    reg en;
    reg signed [7:0] a;
    reg signed [7:0] b;

    wire signed [31:0] acc;
    wire acc_valid;

    // 实例化 MAC 模块
    mac_int8 uut (
        .clk(clk),
        .rst_n(rst_n),
        .clear(clear),
        .en(en),
        .a(a),
        .b(b),
        .acc(acc),
        .acc_valid(acc_valid)
    );

    // 100MHz时钟，周期10ns
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    initial begin
        rst_n = 0;
        clear = 0;
        en = 0;
        a = 0;
        b = 0;

        // 复位
        #20;
        rst_n = 1;

        // 清零累加器
        @(negedge clk);
        clear = 1;
        @(negedge clk);
        clear = 0;

        // 第一次：2 * 3 = 6
        a = 8'sd2;
        b = 8'sd3;
        en = 1;
        @(negedge clk);

        // 第二次：4 * 5 = 20，累计26
        a = 8'sd4;
        b = 8'sd5;
        @(negedge clk);

        // 第三次：3 * 2 = 6，累计32
        a = 8'sd3;
        b = 8'sd2;
        @(negedge clk);

        en = 0;

        // 负数测试：-2 * 3 = -6
        a = -8'sd2;
        b = 8'sd3;
        en = 1;
        @(negedge clk);

        en = 0;
        #10;

        // 清零测试
        clear = 1;
        #10;
        clear = 0;

        #30;
        $finish;
    end

endmodule
