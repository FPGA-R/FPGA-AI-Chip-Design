`timescale 1ns / 1ps

module tb_uart_mac;

    localparam integer CLKS_PER_BIT = 868;

    reg clk;
    reg rst_n;
    reg uart_rx;
    wire uart_tx;

    reg [7:0] rx_byte;

    // 被测试的完整顶层模块
    uart_calculator uut (
        .clk_100m (clk),
        .rst_n    (rst_n),
        .uart_rx  (uart_rx),
        .uart_tx  (uart_tx)
    );

    // 100MHz时钟，周期10ns
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    // ------------------------------------------------
    // 模拟电脑向FPGA发送一个UART字节
    // ------------------------------------------------
    task send_byte;
        input [7:0] data;
        integer i;
        begin
            @(negedge clk);
            uart_rx = 1'b0;  // 起始位

            repeat(CLKS_PER_BIT)
                @(negedge clk);

            for (i = 0; i < 8; i = i + 1) begin
                uart_rx = data[i];

                repeat(CLKS_PER_BIT)
                    @(negedge clk);
            end

            uart_rx = 1'b1;  // 停止位

            repeat(CLKS_PER_BIT)
                @(negedge clk);
        end
    endtask

    // ------------------------------------------------
    // 发送最后一个字节，提前返回以便接收FPGA响应
    // ------------------------------------------------
    task send_last_byte;
        input [7:0] data;
        integer i;
        begin
            @(negedge clk);
            uart_rx = 1'b0;

            repeat(CLKS_PER_BIT)
                @(negedge clk);

            for (i = 0; i < 8; i = i + 1) begin
                uart_rx = data[i];

                repeat(CLKS_PER_BIT)
                    @(negedge clk);
            end

            uart_rx = 1'b1;

            // 只等待半个停止位，不错过FPGA响应起始位
            repeat(CLKS_PER_BIT/2)
                @(negedge clk);
        end
    endtask
    // ------------------------------------------------
    // 模拟电脑接收FPGA返回的一个UART字节
    // ------------------------------------------------
  
task receive_byte;
    output [7:0] data;
    integer i;
    begin
        // 等待发送起始位
        @(negedge uart_tx);

        $display("RX start detected at %0t ns", $time);

        // 等待1.5个波特周期
        repeat(CLKS_PER_BIT + CLKS_PER_BIT/2)
            @(posedge clk);

        #1;

        // 采样8个数据位
        for (i = 0; i < 8; i = i + 1) begin

            data[i] = uart_tx;

            $display("  bit[%0d] = %b, time = %0t ns",
                     i, data[i], $time);

            repeat(CLKS_PER_BIT)
                @(posedge clk);

            #1;
        end
        
        

        // 检查停止位
        $display("  STOP = %b, time = %0t ns",
                 uart_tx, $time);

        if (uart_tx !== 1'b1) begin
            $display("ERROR: UART stop bit error!");
            $display("Received data = %02h", data);
            $display("Simulation time = %0t ns", $time);
            $stop;
        end
        else begin
            $display("PASS: UART stop bit");
        end
    end
endtask

        // ------------------------------------------------
    // 检查4字节响应
    // ------------------------------------------------
    task check4;
        input [7:0] e0, e1, e2, e3;
        reg [7:0] d0, d1, d2, d3;
        begin
            receive_byte(d0);
            receive_byte(d1);
            receive_byte(d2);
            receive_byte(d3);

            $display("RX: %02h %02h %02h %02h",
                     d0, d1, d2, d3);

            if ((d0 !== e0) || (d1 !== e1) ||
                (d2 !== e2) || (d3 !== e3)) begin
                $display("ERROR: 4-byte response mismatch!");
                $stop;
            end
            else begin
                $display("PASS: 4-byte response");
            end
        end
    endtask

    // ------------------------------------------------
    // 检查6字节响应
    // ------------------------------------------------
    task check6;
        input [7:0] e0, e1, e2, e3, e4, e5;
        reg [7:0] d0, d1, d2, d3, d4, d5;
        begin
            receive_byte(d0);
            receive_byte(d1);
            receive_byte(d2);
            receive_byte(d3);
            receive_byte(d4);
            receive_byte(d5);

            $display("RX: %02h %02h %02h %02h %02h %02h",
                     d0, d1, d2, d3, d4, d5);

            if ((d0 !== e0) || (d1 !== e1) ||
                (d2 !== e2) || (d3 !== e3) ||
                (d4 !== e4) || (d5 !== e5)) begin
                $display("ERROR: 6-byte response mismatch!");
                $stop;
            end
            else begin
                $display("PASS: 6-byte response");
            end
        end
    endtask

    // ------------------------------------------------
    // 测试流程
    // ------------------------------------------------
    initial begin

        rst_n   = 0;
        uart_rx = 1;

        // 复位
        repeat(20)
            @(negedge clk);

        rst_n = 1;

        repeat(100)
            @(negedge clk);

        // ==========================================
        // 测试1：原有加法
        // 0x12 + 0x34 = 0x0046
        // ==========================================

        $display("TEST 1: ADD");

        send_byte(8'hA5);
        send_byte(8'h01);
        send_byte(8'h12);
        send_last_byte(8'h34);

check4(8'h5A, 8'h01, 8'h00, 8'h46);

        // ==========================================
        // 测试2：原有减法
        // 0x12 - 0x34 = -34 = 0xFFDE
        // ==========================================

$display("TEST 2: SUB");

send_byte(8'hA5);
send_byte(8'h02);
send_byte(8'h12);
send_last_byte(8'h34);

check4(8'h5A, 8'h02, 8'hFF, 8'hDE);
        // ==========================================
        // 测试3：MAC清零
        // ==========================================

        $display("TEST 3: MAC CLEAR");

        send_byte(8'hA5);
        send_byte(8'h03);
        send_byte(8'h00);
        send_last_byte(8'h00);

        check6(8'h5A, 8'h03,
              8'h00, 8'h00, 8'h00, 8'h00);

        // ==========================================
        // 测试4：0 + 2*3 = 6
        // ==========================================

        $display("TEST 4: MAC 2*3");

        send_byte(8'hA5);
        send_byte(8'h04);
        send_byte(8'h02);
        send_last_byte(8'h03);

        check6(8'h5A, 8'h04,
              8'h00, 8'h00, 8'h00, 8'h06);

        // ==========================================
        // 测试5：6 + 4*5 = 26
        // ==========================================

        $display("TEST 5: MAC 4*5");

        send_byte(8'hA5);
        send_byte(8'h04);
        send_byte(8'h04);
        send_last_byte(8'h05);

        check6(8'h5A, 8'h04,
              8'h00, 8'h00, 8'h00, 8'h1A);

        // ==========================================
        // 测试6：26 + 3*2 = 32
        // ==========================================

        $display("TEST 6: MAC 3*2");

        send_byte(8'hA5);
        send_byte(8'h04);
        send_byte(8'h03);
        send_last_byte(8'h02);

        check6(8'h5A, 8'h04,
              8'h00, 8'h00, 8'h00, 8'h20);

        // ==========================================
        // 测试7：32 + (-2)*3 = 26
        // -2的INT8补码为FE
        // ==========================================

        $display("TEST 7: MAC -2*3");

        send_byte(8'hA5);
        send_byte(8'h04);
        send_byte(8'hFE);
        send_last_byte(8'h03);

        check6(8'h5A, 8'h04,
              8'h00, 8'h00, 8'h00, 8'h1A);

        $display("--------------------------------");
        $display("ALL UART + MAC TESTS PASSED!");
